{% extends "base.html.twig" %}

{% block title %}{{ "admin-menu-link"|trans }}{% endblock %}

{% block body %}
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="calendars-tab" data-bs-toggle="tab" href="#calendars" role="tab"
               aria-controls="calendars" aria-selected="true">{{ "calendars-label"|trans }}</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="users-tab" data-bs-toggle="tab" href="#users" role="tab"
               aria-controls="users" aria-selected="false">{{ "users-label"|trans }}</a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane show active" id="calendars" role="tabpanel" aria-labelledby="calendars-tab">
            <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th scope="col">{{ "calendar-label"|trans }}</th>
                    <th scope="col">{{ "actions-label"|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for calendar in calendars %}
                    <tr>
                        <td><a href="{{ path('default_view', {slug: calendar.slug}) }}">{{ calendar.title }}</a></td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ path('calendar_admin', {slug: calendar.slug}) }}"><i
                                        class="bi bi-wrench"></i> {{ "settings-button"|trans }}</a>
                            {{ include('components/confirmation.html.twig', {
                                id: 'deleteCalendarModal' ~ calendar.cid,
                                button: 'delete-menu-link'|trans,
                                small: true,
                                title: "delete-confirmation-modal-title"|trans,
                                question: "permanently-delete-calendar-question"|trans,
                                path: path('delete_calendar', {slug: calendar.slug}),
                                token_id: 'delete-calendar-' ~ calendar.cid,
                                confirm_button: "delete-button"|trans,
                            }) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <a class="btn btn-primary" href="{{ path('create_calendar') }}">
                <i class="bi bi-plus-square"></i> {{ "create-calendar-button"|trans }}
            </a>
        </div>

        <div class="tab-pane" id="users" role="tabpanel" aria-labelledby="users-tab">
            <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th scope="col">{{ "username-label"|trans }}</th>
                    <th scope="col">{{ "actions-label"|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>
                            {{ user.username }}
                            {% if user.admin %}<span class="badge text-bg-secondary">{{ "site-admin-label"|trans }}</span>{% endif %}
                            {% if user.disabled %}<span class="badge text-bg-warning">{{ "disabled-label"|trans }}</span>{% endif %}
                        </td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ path('edit_user', {uid: user.uid}) }}">{{ "edit-link"|trans }}</a>
                            {% if user != app.user %}
                                <form method="post" action="{{ path(user.disabled ? 'enable_user' : 'disable_user', {uid: user.uid}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle-user-' ~ user.uid) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        {{ (user.disabled ? "enable-user-label" : "disable-user-label")|trans }}
                                    </button>
                                </form>
                                {{ include('components/confirmation.html.twig', {
                                    id: 'deleteUserModal' ~ user.uid,
                                    button: 'delete-menu-link'|trans,
                                    small: true,
                                    title: "delete-confirmation-modal-title"|trans,
                                    question: "permanently-delete-user-question"|trans,
                                    path: path('delete_user', {uid: user.uid}),
                                    token_id: 'delete-user-' ~ user.uid,
                                    confirm_button: "delete-button"|trans,
                                }) }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <a class="btn btn-primary" href="{{ path('create_user') }}">
                <i class="bi bi-plus-square"></i> {{ "create-user-button"|trans }}
            </a>
        </div>
    </div>
{% endblock %}
