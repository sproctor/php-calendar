{#
  The site admin's tabs. Calendars and Users are panes of the admin page itself (`active` is null
  there and Bootstrap switches them); Views, Appearance and Email are their own pages, named by `active`.
#}
{% set on_index = active is null %}
<ul class="nav nav-tabs mb-3"{% if on_index %} role="tablist"{% endif %}>
    {% set pane_icons = {calendars: 'bi:calendar3', users: 'bi:people'} %}
    {% for pane, icon in pane_icons %}
        <li class="nav-item"{% if on_index %} role="presentation"{% endif %}>
            {% if on_index %}
                <a class="nav-link{{ loop.first ? ' active' }}" id="{{ pane }}-tab" data-bs-toggle="tab" href="#{{ pane }}" role="tab"
                   aria-controls="{{ pane }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ ux_icon(icon) }} {{ (pane ~ '-label')|trans }}</a>
            {% else %}
                <a class="nav-link" href="{{ path('admin', {_fragment: pane}) }}">{{ ux_icon(icon) }} {{ (pane ~ '-label')|trans }}</a>
            {% endif %}
        </li>
    {% endfor %}
    <li class="nav-item">
        <a class="nav-link{{ active == 'views' ? ' active' }}" href="{{ path('admin_views') }}"
           {% if active == 'views' %}aria-current="page"{% endif %}>{{ ux_icon('bi:collection') }} {{ 'views-label'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'appearance' ? ' active' }}" href="{{ path('admin_appearance') }}"
           {% if active == 'appearance' %}aria-current="page"{% endif %}>{{ ux_icon('bi:palette') }} {{ 'appearance-title'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'mail' ? ' active' }}" href="{{ path('mail_settings') }}"
           {% if active == 'mail' %}aria-current="page"{% endif %}>{{ ux_icon('bi:envelope') }} {{ 'mail-settings-title'|trans({}, 'account') }}{% if not mail_enabled() %} <span class="badge text-bg-secondary">{{ 'mail-off-badge'|trans({}, 'account') }}</span>{% endif %}</a>
    </li>
</ul>
