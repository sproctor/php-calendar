{# Previous / Today / Next buttons for the calendar views #}
<div class="btn-group btn-group-sm" role="group" aria-label="{{ 'date-navigation-label'|trans }}">
    <a class="btn btn-outline-secondary" href="{{ prev_url }}" aria-label="{{ prev_label|trans }}" title="{{ prev_label|trans }}"><i class="bi-chevron-left"></i></a>
    <a class="btn btn-outline-secondary" href="{{ today_url }}">{{ 'today-button'|trans }}</a>
    <a class="btn btn-outline-secondary" href="{{ next_url }}" aria-label="{{ next_label|trans }}" title="{{ next_label|trans }}"><i class="bi-chevron-right"></i></a>
</div>
