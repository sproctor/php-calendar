{% extends 'base.html.twig' %}
{% trans_default_domain 'account' %}

{% block title %}{{ 'invalid-link-title'|trans }}{% endblock %}

{% block body %}
    <div class="phpc-narrow">
        <h1 class="h3">{{ 'invalid-link-title'|trans }}</h1>
        <p>{{ 'invalid-link-message'|trans }}</p>
        {% if retry_url %}
            <a class="btn btn-primary" href="{{ retry_url }}">{{ 'request-new-link-button'|trans }}</a>
        {% endif %}
    </div>
{% endblock %}
