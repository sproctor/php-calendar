{#- How an embedded page should look (see EmbedOptions), null when not embedded -#}
{%- set embed = embed_options() -%}
{%- set embedded = embed is not null -%}
{#- The calendar or view this page shows (calendar pages also set `calendar`), and the calendar for the
    menus: this one, or the last one visited -#}
{%- set page_source = source is defined ? source : (calendar is defined ? calendar : null) -%}
{%- set nav_calendar = calendar is defined ? calendar : last_calendar() -%}
{%- set theme = embed.theme ?? page_theme(page_source ?? nav_calendar) -%}
{#- Light, dark, or auto (follow the browser). Embedded calendars are light, to match most host pages,
    unless the embed code chose a mode; themes designed dark are always dark. -#}
{%- set color_mode = embedded ? (embed.mode ?? 'light') : app.request.cookies.get('phpc_color_mode') -%}
{%- set color_mode = theme.darkOnly ? 'dark' : (color_mode in ['light', 'dark'] ? color_mode : 'auto') -%}
<!doctype html>
<html lang="{{ app.request.locale|replace({'_': '-'}) }}"{% if is_rtl(app.request.locale) %} dir="rtl"{% endif %} data-bs-theme="{{ color_mode == 'dark' ? 'dark' : 'light' }}" data-phpc-color-mode="{{ color_mode }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if color_mode == 'auto' %}
        {# Before anything is drawn, so dark-mode visitors don't see a flash of the light theme #}
        <script>if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.dataset.bsTheme = 'dark';</script>
    {% endif %}

    <title>{% block title %}PHP Calendar{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ page_source ? 'calendar-meta-description'|trans({'%calendar%': page_source.title}) : 'meta-description'|trans }}{% endblock %}">

    <link rel="icon" href="{{ asset('static/office-calendar.png') }}">
    <link rel="stylesheet" id="phpc-theme" href="{{ asset(theme.stylesheetFor(is_rtl(app.request.locale))) }}">
    <link rel="stylesheet" href="{{ asset('static/phpc.css') }}">
    {% if embed and embed.css %}
        {# Validated colors and font names only, see EmbedOptions::css() #}
        <style>{{ embed.css|raw }}</style>
    {% endif %}
    {% set public_feed = page_source ? public_feed(page_source) : null %}
    {% if public_feed %}
        <link rel="alternate" type="text/calendar" title="{{ page_source.title }}" href="{{ public_feed }}">
    {% endif %}
    {% block structured_data %}{% endblock %}
</head>
<body{% if embedded %} data-embed="1"{% endif %}>
{% if embedded %}
    {% if embed.header %}
        <div class="d-flex align-items-center px-2 py-1 bg-body-tertiary">
            {% if page_source %}
                <a class="fw-semibold text-decoration-none" href="{{ source_path(page_source, 'default') }}" target="_blank" rel="noopener">{{ page_source.title }}</a>
            {% endif %}
            <a class="ms-auto small" href="{{ app.request.baseUrl ~ app.request.pathInfo }}" target="_blank" rel="noopener">{{ ux_icon('bi:box-arrow-up-right') }} {{ 'open-full-calendar-link'|trans }}</a>
        </div>
    {% endif %}
{% else %}
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            {# The calendar or view shown; on other pages, the calendar last viewed. A menu switches to the
               others, and to views. Variables set here are seen by every page's blocks, so they're named
               nav_… to stay out of the pages' way. #}
            {% set nav_brand = page_source ?? nav_calendar %}
            {% if nav_brand %}
                {% set nav_calendars = get_calendars() %}
                {% set nav_views = get_views() %}
                {% if nav_calendars|length > 1 or nav_views is not empty %}
                    <div class="nav-item dropdown">
                        <button class="btn btn-link navbar-brand dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">{{ nav_brand.title }}</button>
                        <div class="dropdown-menu">
                            {% for cal in nav_calendars %}
                                <a class="dropdown-item{{ page_source and not page_source.view and page_source.slug == cal.slug ? ' active' }}"
                                   href="{{ path('default_view', {slug: cal.slug}) }}">{{ cal.title }}</a>
                            {% endfor %}
                            {% if nav_views is not empty %}
                                <div class="dropdown-divider"></div>
                                <h6 class="dropdown-header">{{ 'views-label'|trans }}</h6>
                                {% for nav_view in nav_views %}
                                    <a class="dropdown-item{{ page_source and page_source.view and page_source.slug == nav_view.slug ? ' active' }}"
                                       href="{{ source_path(nav_view, 'default') }}">{{ ux_icon('bi:collection') }} {{ nav_view.title }}</a>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <a class="navbar-brand" href="{{ source_path(nav_brand, 'default') }}">{{ nav_brand.title }}</a>
                {% endif %}
            {% endif %}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#phpc-navbar"
                    aria-controls="phpc-navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="phpc-navbar">
                <ul class="navbar-nav me-auto">
                    {% if page_source and date is defined %}
                        {% set month_route = source_route(page_source, 'month') %}
                        {% if app.current_route not in [month_route, source_route(page_source, 'default')] %}
                            {{ menu_item(month_route, "view-month-menu-link"|trans, 'calendar3', {slug: page_source.slug, month: date|month, year: date|year}) }}
                        {% endif %}
                    {% endif %}
                    {% set site_admin = is_granted('ROLE_ADMIN') %}
                    {% set calendar_admin = nav_calendar and is_granted('CALENDAR_ADMIN', nav_calendar) %}
                    {% if site_admin and calendar_admin %}
                        <li class="nav-item dropdown">
                            <button class="btn btn-link nav-link dropdown-toggle{{ app.current_route in ['admin', 'calendar_admin'] ? ' active' }}" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">{{ ux_icon('bi:gear') }}
                                {{ "admin-menu-link"|trans }}
                            </button>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href="{{ path('calendar_admin', {slug: nav_calendar.slug}) }}">{{ ux_icon('bi:sliders') }} {{ "calendar-admin-menu-link"|trans }}</a>
                                <a class="dropdown-item" href="{{ path('admin') }}">{{ ux_icon('bi:gear') }} {{ "site-admin-menu-link"|trans }}</a>
                            </div>
                        </li>
                    {% elseif site_admin %}
                        {{ menu_item("admin", "admin-menu-link"|trans, 'gear') }}
                    {% elseif calendar_admin %}
                        {{ menu_item("calendar_admin", "calendar-admin-menu-link"|trans, "sliders", {slug: nav_calendar.slug}) }}
                    {% endif %}
                    <li class="nav-item dropdown">
                        <button class="btn btn-link nav-link dropdown-toggle" type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">{{ ux_icon('bi:translate') }}
                            {{ "language-menu-selector"|trans }}
                        </button>
                        <div class="dropdown-menu">
                            {% for code,lang in languages %}
                                <a class="dropdown-item"
                                   href="{{ change_locale(code) }}">{{ lang }}</a>
                            {% endfor %}
                        </div>
                    </li>
                    {% if not theme.darkOnly %}
                        {% set color_mode_icons = {light: 'bi:sun-fill', dark: 'bi:moon-stars-fill', auto: 'bi:circle-half'} %}
                        <li class="nav-item dropdown phpc-color-mode" data-cookie-path="{{ app.request.basePath ~ '/' }}">
                            <button class="btn btn-link nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                {% for mode, icon in color_mode_icons %}
                                    <span class="phpc-color-mode-icon" data-mode="{{ mode }}">{{ ux_icon(icon) }}</span>
                                {% endfor %}
                                {{ "color-mode-menu-label"|trans }}
                            </button>
                            <div class="dropdown-menu">
                                {% for mode, icon in color_mode_icons %}
                                    <button class="dropdown-item{{ mode == color_mode ? ' active' }}" type="button" data-mode="{{ mode }}"
                                            aria-pressed="{{ mode == color_mode ? 'true' : 'false' }}">
                                        {{ ux_icon(icon) }} {{ ('color-mode-' ~ mode)|trans }}
                                    </button>
                                {% endfor %}
                            </div>
                        </li>
                    {% endif %}
                    <li class="nav-item dropdown">
                        <button class="btn btn-link nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">{{ ux_icon('bi:person') }}
                            {% if app.user is null %}
                                {{ "anonymous"|trans }}
                            {% else %}
                                {{ app.user.username }}
                            {% endif %}
                        </button>
                        <div class="dropdown-menu">
                            {% if not app.user is null %}
                                <a class="dropdown-item" href="{{ path("user_settings") }}">{{ ux_icon('bi:gear') }} {{ "settings-menu-link"|trans }}</a>
                                <a class="dropdown-item" href="{{ logout_path() }}">{{ ux_icon('bi:box-arrow-right') }} {{ "log-out-menu-link"|trans }}</a>
                            {% else %}
                                <a class="dropdown-item"
                                   href="{{ path("app_login", { target_path: app.request.requestUri }) }}">{{ ux_icon('bi:box-arrow-in-right') }} {{ "log-in-menu-link"|trans }}</a>
                            {% endif %}
                        </div>
                    </li>
                </ul>
                {% if page_source %}
                <form class="d-flex ms-auto" role="search" action="{{ source_path(page_source, 'search') }}" method="get">
                    <div class="input-group">
                        <input id="search-input" class="form-control" name="q" type="search"
                               placeholder="{{ "search-label"|trans }}" aria-label="{{ "search-label"|trans }}">
                        <button class="btn btn-primary" title="{{ "search-label"|trans }}" type="submit">
                            {{ ux_icon('bi:search') }}
                        </button>
                    </div>
                </form>
                {% endif %}
            </div>
        </div>
    </nav>
{% endif %}

<div class="container-fluid">
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mt-3 mb-0" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'close'|trans }}"></button>
        </div>
    {% endfor %}
{% endfor %}
</div>

<main class="phpc-body container-fluid pt-3 pb-4">
    {% block body %}{% endblock %}
</main>


<script defer src="{{ asset('static/lib/bootstrap/bootstrap.bundle.min.js') }}"></script>
<script defer src="{{ asset('static/phpc.js') }}"></script>

{% block script %}{% endblock %}

</body>
</html>
