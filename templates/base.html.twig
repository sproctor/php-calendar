<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}PHP Calendar{% endblock %}</title>

    <link rel="icon" href="{{ asset('static/office-calendar.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('static/phpc.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
{% set embedded = is_embedded() %}
<body{% if embedded %} data-embed="1"{% endif %}>
{% if embedded %}
    <div class="d-flex align-items-center px-2 py-1 bg-light">
        {% if calendar is defined %}
            <a class="fw-semibold text-decoration-none" href="{{ path('default_view', {cid: calendar.cid}) }}" target="_blank" rel="noopener">{{ calendar.title }}</a>
        {% endif %}
        <a class="ms-auto small" href="{{ app.request.baseUrl ~ app.request.pathInfo }}" target="_blank" rel="noopener"><i class="bi-box-arrow-up-right"></i> {{ 'open-full-calendar-link'|trans }}</a>
    </div>
{% else %}
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container-fluid">
            {% if calendar is defined %}
                {% set calendars = get_calendars() %}
                {% if calendars|length > 1 %}
                    <div class="nav-item dropdown">
                        <button class="btn btn-link navbar-brand dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">{{ calendar.title }}</button>
                        <div class="dropdown-menu">
                            {% for cal in calendars %}
                                <a class="dropdown-item" href="{{ path('default_view', {cid: cal.cid}) }}">{{ cal.title }}</a>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <a class="navbar-brand" href="{{ path('default_view', {cid: calendar.cid}) }}">{{ calendar.title }}</a>
                {% endif %}
            {% endif %}
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#phpc-navbar"
                    aria-controls="phpc-navbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="phpc-navbar">
                <ul class="navbar-nav me-auto">
                    {% if calendar is defined %}
                        {% if is_granted('CALENDAR_CREATE', calendar) %}
                            {{ menu_item("create_event", "create-event-label"|trans, 'plus', {cid: calendar.cid}) }}
                        {% endif %}
                        {% if app.current_route != 'month_view' and app.current_route != 'default_view' and date is defined %}
                            {{ menu_item("month_view", "view-month-menu-link"|trans, 'calendar3', {cid: calendar.cid, month: date|month, year: date|year}) }}
                        {% endif %}
                        {% if app.current_route not in ['day_view'] and date is defined %}
                            {{ menu_item("day_view", "view-date-menu-link"|trans, 'calendar-day', {cid: calendar.cid}|merge(date|dateparts)) }}
                        {% endif %}
                    {% endif %}
                    {% if app.user and app.user.isAdmin %}
                        {{ menu_item("admin", "admin-menu-link"|trans, 'gear') }}
                    {% endif %}
                    {% if calendar is defined and is_granted('CALENDAR_ADMIN', calendar) %}
                        {{ menu_item("calendar_admin", "calendar-admin-menu-link"|trans, "sliders", {cid: calendar.cid}) }}
                    {% endif %}
                    <li class="nav-item dropdown">
                        <button class="btn btn-link nav-link dropdown-toggle" type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"><i class="bi-translate"></i>
                            {{ "language-menu-selector"|trans }}
                        </button>
                        <div class="dropdown-menu">
                            {% for code,lang in languages %}
                                <a class="dropdown-item"
                                   href="{{ change_locale(code) }}">{{ lang }}</a>
                            {% endfor %}
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="btn btn-link nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false"><i class="bi-person"></i>
                            {% if app.user is null %}
                                {{ "anonymous"|trans }}
                            {% else %}
                                {{ app.user.username }}
                            {% endif %}
                        </button>
                        <div class="dropdown-menu">
                            {% if not app.user is null %}
                                <a class="dropdown-item" href="{{ path("user_settings") }}"><i
                                            class="bi-gear"></i> {{ "settings-menu-link"|trans }}</a>
                                <a class="dropdown-item" href="{{ logout_path() }}"><i
                                            class="bi-bow-arrow-right"></i> {{ "log-out-menu-link"|trans }}</a>
                            {% else %}
                                <a class="dropdown-item"
                                   href="{{ path("app_login", { target_path: app.request.requestUri }) }}"><i
                                            class="bi-box-arrow-in-right"></i> {{ "log-in-menu-link"|trans }}</a>
                            {% endif %}
                        </div>
                    </li>
                </ul>
                {% if calendar is defined %}
                <form class="d-flex ms-auto" role="search" action="{{ path('search', {cid: calendar.cid}) }}" method="get">
                    <div class="input-group">
                        <input id="search-input" class="form-control" name="q" type="search"
                               placeholder="{{ "search-label"|trans }}" aria-label="{{ "search-label"|trans }}">
                        <button class="btn btn-primary" title="{{ "search-label"|trans }}" type="submit">
                            <i class="bi-search"></i>
                        </button>
                    </div>
                </form>
                {% endif %}
            </div>
        </div>
    </nav>
{% endif %}

<div class="container-fluid">
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mt-2" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'close'|trans }}"></button>
        </div>
    {% endfor %}
{% endfor %}
</div>

<div class="phpc-body container-fluid">
    {% block body %}{% endblock %}
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.16/dist/purify.min.js"
        integrity="sha384-a7SzOxErzJ3ZpQz0zJ32d67dSitNzPcbfybc/ykU9KJhMgZkwqfSxlhhdJRS+XGL"
        crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/5.1.1/marked.min.js"
        integrity="sha512-geNSPsVaubOv19D7VZY9lJH7MNdRkIq84doaoubf6zknjXsyBQ77XQbqiHX89Mg3e+67E16huocEGUlR4Pgjtg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="{{ asset('static/phpc.js') }}"></script>

{% block script %}{% endblock %}

</body>
</html>
