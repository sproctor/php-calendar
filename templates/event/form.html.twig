{% extends "base.html.twig" %}

{% set heading = modifying ? 'modify-event-title' : 'create-event-label' %}
{% block title %}{{ heading|trans }}{% endblock %}

{% block body %}
    <h3>{{ heading|trans }}</h3>
    {{ form_start(form) }}
    {{ form_row(form.subject) }}
    <div class="mb-3">
        {{ form_label(form.description) }}
        <a href="https://commonmark.org/help/" target="_blank" rel="noopener" title="{{ 'markdown-help-link'|trans }}">{{ ux_icon('bi:info-circle') }}</a>
        {{ form_widget(form.description) }}
        {{ form_errors(form.description) }}
    </div>
    {% if form.category is defined %}
        {{ form_row(form.category) }}
    {% endif %}
    {% for child in form.children|filter((child, name) => name starts with 'field_') %}
        {{ form_row(child) }}
    {% endfor %}
    {% if form.readonly is defined %}
        {{ form_row(form.readonly) }}
    {% endif %}

    {% if form.modify is defined %}
        {{ form_row(form.modify, {attr: {class: 'phpc-modify'}}) }}
    {% endif %}
    <fieldset id="time_data">
        {{ include('event/_times.html.twig', {times: form.times}) }}
        {{ form_row(form.repeats) }}
        <div id="repeat_data" class="row">
            <div class="col-md-6 phpc-frequency">{{ form_row(form.frequency) }}</div>
            <div class="col-md-6">{{ form_row(form.until) }}</div>
        </div>
    </fieldset>

    {{ form_row(form.delay_publish, {attr: {class: 'phpc-delay-publish'}}) }}
    <div id="publish_data">
        {{ form_row(form.pubtime) }}
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block script %}
    {{ include('event/_times_script.html.twig') }}
    <script>
        const toggle = (checkbox, section) => {
            if (!checkbox) {
                return;
            }
            const update = () => {
                section.hidden = !checkbox.checked;
            };
            checkbox.addEventListener('change', update);
            update();
        };
        // Only show the date and time fields when changing them while editing
        toggle(document.querySelector('.phpc-modify'), document.getElementById('time_data'));
        toggle(document.querySelector('.phpc-delay-publish'), document.getElementById('publish_data'));

        const repeatLabels = {
            D: {{ 'repeat-every-unit-question'|trans({'%unit%': 'days'|trans})|json_encode|raw }},
            W: {{ 'repeat-every-unit-question'|trans({'%unit%': 'weeks'|trans})|json_encode|raw }},
            M: {{ 'repeat-every-unit-question'|trans({'%unit%': 'months'|trans})|json_encode|raw }},
            Y: {{ 'repeat-every-unit-question'|trans({'%unit%': 'years'|trans})|json_encode|raw }},
        };
        const repeatSelector = document.querySelector('.phpc-repeats');
        const repeatData = document.getElementById('repeat_data');
        const updateRepeat = () => {
            const label = repeatLabels[repeatSelector.value];
            repeatData.hidden = label === undefined;
            if (label !== undefined) {
                repeatData.querySelector('.phpc-frequency label').textContent = label;
            }
        };
        repeatSelector.addEventListener('change', updateRepeat);
        updateRepeat();
    </script>
{% endblock %}
