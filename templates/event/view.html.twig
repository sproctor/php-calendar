{% extends "base.html.twig" %}

{% block title %}{{ event.subject }} – {{ calendar.title }}{% endblock %}

{% block description %}{{ event.subject }}{% if event.occurrences is not empty %} – {{ event.occurrences.first.datetimeString|trans }}{% endif %} – {{ calendar.title }}{% endblock %}

{% block body %}
    <h3>
        {{ event.subject }}
        {% if event.readonly %}<span title="{{ 'readonly-event-label'|trans }}">{{ ux_icon('bi:lock', {'aria-label': 'readonly-event-label'|trans}) }}</span>{% endif %}
    </h3>

    <div class="phpc-event-header text-secondary mb-2">
        <div>
            {% if event.owner %}{{ "by-author"|trans({'%author%': event.owner.username}) }}{% endif %}
            {{ "on-date-time"|trans({'%datetime%': event.created|format_datetime('medium', 'short')}) }}
        </div>
        {% if event.modified is not null %}
            <div>{{ "last-modified"|trans({'%modified%': event.modified|format_datetime('medium', 'short')}) }}</div>
        {% endif %}
        {% if event.category %}
            <div>{{ "category-declaration"|trans({'%category%': event.category.name}) }}
                <span class="badge" style="color: {{ event.textColor }}; background: {{ event.color }};">&nbsp;</span></div>
        {% endif %}
        {% if not event.published %}
            <div class="text-warning">{{ "publishes-at-message"|trans({'%datetime%': event.pubtime|format_datetime('medium', 'short')}) }}</div>
        {% endif %}
    </div>

    {% set can_edit = is_granted('EVENT_EDIT', event) %}
    {% if can_edit %}
        <nav class="nav nav-pills mb-3 gap-2">
            <a class="nav-item nav-link" href="{{ path('modify_event', {eid: event.eid}) }}">{{ "modify-menu-link"|trans }}</a>
            <a class="nav-item nav-link" href="{{ path('create_occurrence', {eid: event.eid}) }}">{{ "add-occurrence-menu-link"|trans }}</a>
            {{ include('components/confirmation.html.twig', {
                id: 'deleteEventModal',
                button: 'delete-menu-link'|trans,
                title: "delete-confirmation-modal-title"|trans,
                question: "permanently-delete-event-question"|trans,
                path: path('delete_event', {eid: event.eid}),
                token_id: 'delete-event-' ~ event.eid,
                confirm_button: "delete-button"|trans,
            }) }}
        </nav>
    {% endif %}

    {% set definitions = calendar.fieldDefinitions %}
    {% if event.fields is not empty %}
        <h4>{{ "fields-title"|trans }}</h4>
        <dl class="row">
            {% for definition in definitions %}
                {% set value = event.fieldValue(definition) %}
                {% if value is not null %}
                    <dt class="col-sm-3">{{ definition.name }}</dt>
                    <dd class="col-sm-9">{{ value }}</dd>
                {% endif %}
            {% endfor %}
        </dl>
    {% endif %}

    {% if event.description is not empty %}
        <div class="phpc-desc">
            <h4>{{ "description-title"|trans }}</h4>
            <div class="border rounded markdown p-3 mb-3">{{ event.description|markdown_to_html }}</div>
        </div>
    {% endif %}

    <div class="phpc-occ mb-3">
        <h4>{{ "occurrences-title"|trans }}</h4>
        {% if can_edit %}
            <form id="delete-occurrences-form" data-phpc-selection="delete-occurrences-button" action="{{ path('delete_occurrences', {eid: event.eid}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-occurrences-' ~ event.eid) }}">
        {% endif %}
        <ul class="list-group mb-2">
            {% if can_edit and event.occurrences|length > 1 %}
                <li class="list-group-item">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="select-all-occurrences" data-phpc-select-all>
                        <label class="form-check-label" for="select-all-occurrences">{{ 'select-all-label'|trans }}</label>
                    </div>
                </li>
            {% endif %}
            {% for occurrence in event.occurrences %}
                <li class="list-group-item d-flex align-items-center gap-2">
                    {% if can_edit %}
                        <input name="oid[]" type="checkbox" class="form-check-input mt-0" value="{{ occurrence.oid }}"
                               id="oid_{{ occurrence.oid }}" aria-label="{{ 'select-occurrence-label'|trans({'%date%': occurrence.datetimeString|trans}) }}">
                    {% endif %}
                    <a href="{{ path('day_view', {slug: calendar.slug}|merge(occurrence.start|dateparts)) }}">{{ occurrence.datetimeString|trans }}</a>
                    {% if can_edit %}
                        <a class="ms-auto btn btn-sm btn-outline-primary" href="{{ path('edit_occurrence', {oid: occurrence.oid}) }}">{{ "edit-link"|trans }}</a>
                    {% endif %}
                </li>
            {% else %}
                <li class="list-group-item">{{ "no-occurrences-message"|trans }}</li>
            {% endfor %}
        </ul>
        {% if can_edit %}
            </form>
            {% if event.occurrences is not empty %}
                {{ include('components/confirmation.html.twig', {
                    id: 'deleteOccurrencesModal',
                    button: 'remove-selected-occurrences-button'|trans,
                    button_id: 'delete-occurrences-button',
                    small: true,
                    title: 'confirmation-required-dialog-title'|trans,
                    question: 'remove-selected-occurrences-question'|trans,
                    form: 'delete-occurrences-form',
                    confirm_button: 'remove-button'|trans,
                }) }}
            {% endif %}
        {% endif %}
    </div>
    {{ include('components/timezone_note.html.twig') }}
{% endblock %}
