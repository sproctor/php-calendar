{# Emails get no stylesheet, so keep them simple: plain text with inline styles for the button #}
<!DOCTYPE html>
<html lang="{{ locale|replace({'_': '-'}) }}">
<body style="font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 16px; line-height: 1.5; color: #212529;">
{% block content %}{% endblock %}
<p style="color: #6c757d; font-size: 14px;">PHP-Calendar</p>
</body>
</html>
