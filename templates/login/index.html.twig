{% extends 'base.html.twig' %}

{% block title %}{{ 'log-in-title'|trans }}{% endblock %}

{% block body %}
    <div class="phpc-narrow">
        <h1 class="h3">{{ 'log-in-title'|trans|ucfirst }}</h1>
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post">
            <div class="mb-3">
                <label class="form-label" for="username">{{ 'username-or-email-label'|trans({}, 'account') }}</label>
                <input class="form-control" type="text" id="username" name="_username" value="{{ last_username }}"
                       autocomplete="username" required autofocus>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">{{ 'password-label'|trans }}</label>
                <input class="form-control" type="password" id="password" name="_password"
                       autocomplete="current-password" required>
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" id="remember_me" name="_remember_me" value="on" checked>
                <label class="form-check-label" for="remember_me">{{ 'remember-me-label'|trans }}</label>
                <div class="form-text">{{ 'remember-me-help'|trans }}</div>
            </div>

            <input type="hidden" name="_target_path" value="{{ target_path }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="d-flex flex-wrap align-items-center gap-3">
                <button class="btn btn-primary" type="submit">{{ 'log-in-button'|trans }}</button>
                {% if mail_enabled() %}
                    <a href="{{ path('forgot_password') }}">{{ 'forgot-password-link'|trans({}, 'account') }}</a>
                {% endif %}
            </div>
        </form>
    </div>
{% endblock %}
