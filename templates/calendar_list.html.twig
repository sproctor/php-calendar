{% extends "base.html.twig" %}

{% block body %}
    <h3>{{ "calendars-label"|trans }}</h3>
    {% if calendars is empty %}
        <p>{{ "no-calendars-message"|trans }}</p>
    {% else %}
        <ul class="list-group">
            {% for calendar in calendars %}
                <li class="list-group-item">
                    <a href="{{ path('calendar_entry_slash', {slug: calendar.slug}) }}">{{ calendar.title }}</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
