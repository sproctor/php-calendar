{% extends "calendar/display.html.twig" %}

{% block title %}{{ date|month_year|ucfirst }} – {{ calendar.title }}{% endblock %}

{% block heading %}{{ date|month_year|ucfirst }}{% endblock %}

{% block navigation %}
    {{ include('components/view_nav.html.twig', {
        prev_url: prev_month_url, next_url: next_month_url,
        prev_label: 'previous-month-label', next_label: 'next-month-label',
    }) }}
    <div class="d-flex gap-1">
        {{ dropdown(date|month_name|ucfirst, months) }}
        {{ dropdown(date|year, years) }}
    </div>
{% endblock %}

{% block content %}
    {% for week_of_month in 1..weeks %}
        {% include 'calendar/week.html.twig' %}
        {% set start_date = add_days(start_date, 7) %}
    {% endfor %}
{% endblock %}
