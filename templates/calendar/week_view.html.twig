{% extends "calendar/display.html.twig" %}

{% block title %}{{ "week-of-year-title"|trans({'%week%': week, '%year%': year}) }}{% endblock %}

{% block navigation %}
<a class="nav-link" href="{{ prev_week_url }}" aria-label="{{ 'previous-week-label'|trans }}"><i class="bi-chevron-left"></i></a>
<span class="fw-semibold">{{ "week-of-year-title"|trans({'%week%': week, '%year%': year}) }}</span>
<a class="nav-link" href="{{ next_week_url }}" aria-label="{{ 'next-week-label'|trans }}"><i class="bi-chevron-right"></i></a>
{% endblock %}

{% block content %}
    {% include 'calendar/week.html.twig' %}
{% endblock %}
