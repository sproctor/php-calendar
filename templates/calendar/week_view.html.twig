{% extends "calendar/display.html.twig" %}

{% block title %}{{ "week-of-year-title"|trans({'%week%': week, '%year%': year}) }} – {{ calendar.title }}{% endblock %}

{% block heading %}
    {{ "week-of-year-title"|trans({'%week%': week, '%year%': year}) }}
    <small class="text-secondary fs-6 fw-normal">{{ start_date|format_date('medium') }} – {{ end_date|format_date('medium') }}</small>
{% endblock %}

{% block navigation %}
    {{ include('components/view_nav.html.twig', {
        prev_url: prev_week_url, next_url: next_week_url,
        prev_label: 'previous-week-label', next_label: 'next-week-label',
    }) }}
{% endblock %}

{% block content %}
    {% include 'calendar/week.html.twig' %}
{% endblock %}
