{# One row of the month or week grid, starting at start_date. In the week view every day is in "the month". #}
{% set can_create = is_granted('CALENDAR_CREATE', calendar) %}
<tr>
    <th class="phpc-date" scope="row">
        <a href="{{ path('week_view', {cid: calendar.cid, year: start_date|week_year, week: start_date|week}) }}">{{ start_date|week }}</a>
    </th>
    {% for day_of_week in 0..6 %}
        {% set cur_date = add_days(start_date, day_of_week) %}
        {% set in_month = app.current_route == 'week_view' or in_same_month(cur_date, date) %}
        <td class="phpc-date{% if not in_month %} phpc-shadow{% endif %}{% if is_today(cur_date) %} phpc-today{% endif %}">
            <div>
                <a class="phpc-day-number"
                   href="{{ path('day_view', {cid: calendar.cid}|merge(cur_date|dateparts)) }}"
                >{% if (not in_month and day_of_week == 0) or cur_date|day == 1 %}{{ cur_date|month_abbr }}{% endif %} {{ cur_date|day }}</a>
                {% if can_create %}
                    <a href="{{ path('create_event', {cid: calendar.cid}|merge(cur_date|dateparts)) }}" class="phpc-add"
                       title="{{ "create-event-label"|trans }}"><i class="bi-plus"></i></a>
                {% endif %}
            </div>
            {% set days_occurrences = occurrences[cur_date|date_index] ?? [] %}
            {% if days_occurrences is not empty %}
                <div class="occurrence-list list-group">
                    {% for occurrence in days_occurrences %}
                        {% if occurrence is null %}
                            <a href="{{ path('day_view', {cid: calendar.cid}|merge(cur_date|dateparts)) }}"
                               class="list-group-item">{{ "view-additional-events-link"|trans }}</a>
                        {% else %}
                            {% set event = occurrence.event %}
                            <a class="phpc-occurrence list-group-item"
                               href="{{ path('event_view', {eid: event.eid}) }}"
                               {% if event.color %}style="color: {{ event.textColor }} !important; background: {{ event.color }} !important;"{% endif %}
                               data-bs-toggle="popover"
                               data-bs-trigger="hover focus"
                               data-bs-html="true"
                               data-bs-placement="auto"
                               data-bs-title="{{ event.subject }}"
                               data-bs-content="{{ occurrence.datetimeString|trans }}{% if event.owner %} — {{ "by-author"|trans({'%author%': event.owner.username}) }}{% endif %}{{ "\n\n" }}{{ event.description }}"
                            >
                                {% set time = occurrence.timeString %}
                                {% if time is not null %}
                                    {% if occurrence.start >= cur_date %}
                                        <span class="badge text-bg-light">{{ time|trans }}</span>
                                    {% else %}
                                        <i class="bi-three-dots"></i>
                                    {% endif %}
                                {% endif %}
                                {{ event.subject }}
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        </td>
    {% endfor %}
</tr>
