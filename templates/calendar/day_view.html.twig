{% extends "base.html.twig" %}

{% block title %}{{ date|format_date('long') }} – {{ calendar.title }}{% endblock %}

{% block body %}
    {% set can_create = is_granted('CALENDAR_CREATE', calendar) %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0 me-2">{{ date|format_date('full')|ucfirst }}</h1>
        {{ include('components/view_nav.html.twig', {
            prev_url: path('day_view', {slug: calendar.slug}|merge(prev_date|dateparts)),
            next_url: path('day_view', {slug: calendar.slug}|merge(next_date|dateparts)),
            prev_label: 'previous-day-label', next_label: 'next-day-label',
        }) }}
        {% if can_create %}
            <a class="btn btn-primary btn-sm ms-auto" href="{{ path('create_event', {slug: calendar.slug}|merge(date|dateparts)) }}">
                <i class="bi-plus"></i> {{ 'create-event-label'|trans }}
            </a>
        {% endif %}
    </div>
    {% if occurrences|length > 0 %}
        {% set editable = occurrences|filter(o => is_granted('EVENT_EDIT', o.event))|map(o => o.oid) %}
        {% set all_day = occurrences|filter(o => not o.hasTime) %}
        {% set timed = occurrences|filter(o => o.hasTime) %}
        <form id="delete-events-form" action="{{ path('delete_events', {slug: calendar.slug}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-events') }}">
            {% for section in [{heading: 'all-day-label', items: all_day}, {heading: 'scheduled-label', items: timed}] %}
                {% if section.items is not empty %}
                    <h2 class="h6 text-uppercase text-secondary mt-3">{{ section.heading|trans }}</h2>
                    <ul class="list-group mb-3 phpc-day-list">
                        {% for occurrence in section.items %}
                            {{ include('calendar/_day_item.html.twig', {can_edit: occurrence.oid in editable}) }}
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endfor %}
        </form>
        {% if editable is not empty %}
            {{ include('components/confirmation.html.twig', {
                id: 'deleteEventsModal',
                button: 'delete-events-button'|trans,
                button_id: 'delete-events-button',
                title: 'delete-confirmation-modal-title'|trans,
                question: 'permanently-delete-selected-events-question'|trans,
                form: 'delete-events-form',
                confirm_button: 'delete-button'|trans,
            }) }}
        {% endif %}
    {% else %}
        <p class="lead">{{ "no-events-message"|trans }}</p>
        {% if can_create %}
            <a class="btn btn-outline-primary" href="{{ path('create_event', {slug: calendar.slug}|merge(date|dateparts)) }}">
                <i class="bi-plus"></i> {{ 'create-event-on-day-button'|trans }}
            </a>
        {% endif %}
    {% endif %}
{% endblock %}

{% block script %}
    <script>
        // "Delete selected" only applies once something is selected
        const deleteButton = document.getElementById('delete-events-button');
        if (deleteButton) {
            const boxes = document.querySelectorAll('#delete-events-form input[name="eid[]"]');
            const update = () => {
                deleteButton.disabled = ![...boxes].some((box) => box.checked);
            };
            boxes.forEach((box) => box.addEventListener('change', update));
            update();
        }
    </script>
{% endblock %}
