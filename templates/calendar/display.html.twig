{% extends "base.html.twig" %}

{% block body %}
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0 me-2">{% block heading %}{% endblock %}</h1>
    {% block navigation %}{% endblock %}
    <div class="ms-auto d-flex flex-wrap gap-2">
        {{ include('components/event_filter.html.twig') }}
        {{ include('components/subscribe.html.twig') }}
        {% if is_granted('CALENDAR_CREATE', source) %}
            <a class="btn btn-primary btn-sm" href="{{ source_path(source, 'create', create_date|dateparts) }}">
                {{ ux_icon('bi:plus') }} {{ 'create-event-label'|trans }}
            </a>
        {% endif %}
    </div>
</div>
{{ include('components/event_filter_notice.html.twig') }}
{# A grid on wider screens, a list of days on phones #}
<div class="d-none d-md-block">
<table class="phpc-month-view table table-bordered">
    <colgroup>
        <col class="wnumber">
        {% for i in 0..6 %}<col class="day">{% endfor %}
    </colgroup>
    <thead class="thead-light">
        <tr>
            <th scope="col"><abbr title="{{ 'week-number-label'|trans }}">{{ "week-number-abbr"|trans }}</abbr></th>
            {% for i in range(0, 6) %}
                <th scope="col">{{ add_days(start_date, i)|day_abbr }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
    {% block content %}{% endblock %}
    </tbody>
</table>
</div>
<div class="d-md-none">
    {{ include('calendar/_agenda.html.twig') }}
</div>
{% if source.view %}
    {# The view's calendars, and which color is which #}
    <p class="small mb-2">
        {% for calendar in source.calendars %}
            {% set color = source.calendarColor(calendar) %}
            <span class="text-nowrap me-3">{% if color %}<span class="phpc-calendar-swatch" style="background: {{ color }};"></span>{% endif %}
                <a class="link-body-emphasis" href="{{ path('default_view', {slug: calendar.slug}) }}">{{ calendar.title }}</a></span>
        {% endfor %}
    </p>
{% endif %}
{% if legend is not empty %}
    {# Which color is which category; in a view, under each calendar's name. Each one filters by it. #}
    <div class="small mb-2" role="group" aria-label="{{ 'categories-label'|trans }}">
        {% for group in legend %}
            <span class="d-inline-flex flex-wrap align-items-center gap-1 me-3">
                <span class="text-secondary">{{ source.view ? group.calendar.title : 'categories-label'|trans }}</span>
                {% for category in group.categories %}
                    {% set selected = filter.category and filter.category.catid == category.catid %}
                    {% if selected %}
                        <a class="badge text-decoration-none" href="{{ filter_path(filter.query|filter((v, k) => k != 'category')) }}"
                           aria-current="true" title="{{ 'all-categories-label'|trans }}"
                           style="color: {{ category.textColor }}; background: {{ category.color }};">{{ ux_icon('bi:check-lg') }} {{ category.name }}</a>
                    {% else %}
                        <a class="badge text-decoration-none" href="{{ filter_path(filter.query|merge({category: category.catid})) }}"
                           title="{{ 'show-only-category-label'|trans({'%category%': category.name}) }}"
                           style="color: {{ category.textColor }}; background: {{ category.color }};">{{ category.name }}</a>
                    {% endif %}
                {% endfor %}
            </span>
        {% endfor %}
    </div>
{% endif %}
{{ include('components/timezone_note.html.twig') }}
{% endblock %}
