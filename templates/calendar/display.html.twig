{% extends "base.html.twig" %}

{% block body %}
<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0 me-2">{% block heading %}{% endblock %}</h1>
    {% block navigation %}{% endblock %}
    {% if is_granted('CALENDAR_CREATE', calendar) %}
        <a class="btn btn-primary btn-sm ms-auto" href="{{ path('create_event', {slug: calendar.slug}|merge(create_date|dateparts)) }}">
            <i class="bi-plus"></i> {{ 'create-event-label'|trans }}
        </a>
    {% endif %}
</div>
{# A grid on wider screens, a list of days on phones #}
<div class="d-none d-md-block">
<table class="phpc-month-view table table-bordered">
    <colgroup>
        <col class="wnumber">
        {% for i in 0..6 %}<col class="day">{% endfor %}
    </colgroup>
    <thead class="thead-light">
        <tr>
            <th scope="col"><abbr title="{{ 'week-number-label'|trans }}">{{ "week-number-abbr"|trans }}</abbr></th>
            {% for i in range(0, 6) %}
                <th scope="col">{{ add_days(start_date, i)|day_abbr }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
    {% block content %}{% endblock %}
    </tbody>
</table>
</div>
<div class="d-md-none">
    {{ include('calendar/_agenda.html.twig') }}
</div>
{% endblock %}
