{% extends "base.html.twig" %}

{% block title %}{{ "calendar-settings-label"|trans }}{% endblock %}

{% macro tab(id, label, icon, active = false) %}
    <li class="nav-item" role="presentation">
        <a class="nav-link{{ active ? ' active' }}" id="{{ id }}-tab" data-bs-toggle="tab" href="#{{ id }}" role="tab"
           aria-controls="{{ id }}" aria-selected="{{ active ? 'true' : 'false' }}">{{ ux_icon(icon) }} {{ label|trans }}</a>
    </li>
{% endmacro %}

{% macro delete_button(id, path, token_id, question) %}
    {{ include('components/confirmation.html.twig', {
        id: id,
        button: 'delete-button'|trans,
        small: true,
        title: 'delete-confirmation-modal-title'|trans,
        question: question|trans,
        path: path,
        token_id: token_id,
        confirm_button: 'delete-button'|trans,
    }) }}
{% endmacro %}

{% block body %}
    {% import _self as m %}
    <ul class="nav nav-tabs mb-3" role="tablist">
        {{ m.tab('settings', 'calendar-settings-label', 'bi:sliders', true) }}
        {{ m.tab('users', 'user-permissions-label', 'bi:shield-lock') }}
        {{ m.tab('roles', 'roles-label', 'bi:person-badge') }}
        {{ m.tab('categories', 'categories-label', 'bi:tags') }}
        {{ m.tab('fields', 'fields-title', 'bi:input-cursor-text') }}
        {{ m.tab('embed', 'embed-label', 'bi:code-slash') }}
    </ul>
    <div class="tab-content">
        <div class="tab-pane show active" id="settings" role="tabpanel" aria-labelledby="settings-tab">
            {{ form(calendar_form) }}
        </div>

        <div class="tab-pane" id="users" role="tabpanel" aria-labelledby="users-tab">
            <p class="text-secondary">{{ "user-permissions-help"|trans }}</p>
            <form method="post" action="{{ path('calendar_permissions', {slug: calendar.slug}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('calendar-permissions-' ~ calendar.cid) }}">
                <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                    <tr>
                        <th scope="col">{{ "username-label"|trans }}</th>
                        {% for permission, label in permission_labels %}
                            <th scope="col" title="{{ permission_help[permission]|trans }}">{{ label|trans }}</th>
                        {% endfor %}
                        <th scope="col">{{ "roles-label"|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        {% set row = permissions[user.uid] ?? null %}
                        <tr>
                            <td>{{ user.username }}{% if user.admin %} <span class="badge text-bg-secondary">{{ "site-admin-label"|trans }}</span>{% endif %}</td>
                            {% for permission, label in permission_labels %}
                                {% set checked = row and attribute(row, 'can' ~ permission|capitalize) %}
                                <td>
                                    <input class="form-check-input" type="checkbox" name="perm[{{ user.uid }}][{{ permission }}]" value="1"
                                           aria-label="{{ user.username }}: {{ label|trans }}"{{ checked ? ' checked' }}>
                                </td>
                            {% endfor %}
                            <td>
                                {% for role in calendar.roles|filter(r => r.hasUser(user)) %}
                                    <span class="badge bg-body-secondary text-body">{{ role.name }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
                <button type="submit" class="btn btn-primary">{{ "update-permissions-button"|trans }}</button>
            </form>
        </div>

        <div class="tab-pane" id="roles" role="tabpanel" aria-labelledby="roles-tab">
            <p class="text-secondary">{{ "roles-help"|trans }}</p>
            <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th scope="col">{{ "name-label"|trans }}</th>
                    <th scope="col">{{ "permissions-label"|trans }}</th>
                    <th scope="col">{{ "members-label"|trans }}</th>
                    <th scope="col">{{ "actions-label"|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for role in calendar.roles %}
                    <tr>
                        <td>{{ role.name }}</td>
                        <td>
                            {% for permission, label in permission_labels|filter((l, p) => attribute(role, 'can' ~ p|capitalize)) %}
                                <span class="badge bg-body-secondary text-body">{{ label|trans }}</span>
                            {% endfor %}
                        </td>
                        <td>{{ role.users|map(u => u.username)|join(', ') }}</td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ path('edit_role', {slug: calendar.slug, rid: role.rid}) }}">{{ "edit-link"|trans }}</a>
                            {{ m.delete_button('deleteRole' ~ role.rid, path('delete_role', {slug: calendar.slug, rid: role.rid}), 'delete-role-' ~ role.rid, 'permanently-delete-role-question') }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <a class="btn btn-primary" href="{{ path('create_role', {slug: calendar.slug}) }}">{{ ux_icon('bi:plus') }} {{ "create-role-title"|trans }}</a>
        </div>

        <div class="tab-pane" id="categories" role="tabpanel" aria-labelledby="categories-tab">
            <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th scope="col">{{ "name-label"|trans }}</th>
                    <th scope="col">{{ "visible-to-role-label"|trans }}</th>
                    <th scope="col">{{ "actions-label"|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for category in calendar.categories %}
                    <tr>
                        <td>
                            <span class="badge" style="color: {{ category.textColor }}; background: {{ category.color }};">{{ category.name }}</span>
                            {% if category.marksDay %}<span class="text-secondary" title="{{ 'marks-day-label'|trans }}">{{ ux_icon('bi:calendar-day-fill', {'aria-label': 'marks-day-label'|trans}) }}</span>{% endif %}
                        </td>
                        <td>{{ category.role ? category.role.name : 'everyone-label'|trans }}</td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ path('edit_category', {slug: calendar.slug, catid: category.catid}) }}">{{ "edit-link"|trans }}</a>
                            {{ m.delete_button('deleteCategory' ~ category.catid, path('delete_category', {slug: calendar.slug, catid: category.catid}), 'delete-category-' ~ category.catid, 'permanently-delete-category-question') }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <a class="btn btn-primary" href="{{ path('create_category', {slug: calendar.slug}) }}">{{ ux_icon('bi:plus') }} {{ "create-category-title"|trans }}</a>
        </div>

        <div class="tab-pane" id="fields" role="tabpanel" aria-labelledby="fields-tab">
            <p class="text-secondary">{{ "fields-help"|trans }}</p>
            <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th scope="col">{{ "name-label"|trans }}</th>
                    <th scope="col">{{ "required-field-label"|trans }}</th>
                    <th scope="col">{{ "field-format-label"|trans }}</th>
                    <th scope="col">{{ "actions-label"|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for field in calendar.fieldDefinitions %}
                    <tr>
                        <td>{{ field.name }}</td>
                        <td>{% if field.required %}{{ ux_icon('bi:check-lg', {'aria-label': 'yes-label'|trans}) }}{% endif %}</td>
                        <td><code>{{ field.format }}</code></td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ path('edit_field', {slug: calendar.slug, fid: field.fid}) }}">{{ "edit-link"|trans }}</a>
                            {{ m.delete_button('deleteField' ~ field.fid, path('delete_field', {slug: calendar.slug, fid: field.fid}), 'delete-field-' ~ field.fid, 'permanently-delete-field-question') }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <a class="btn btn-primary" href="{{ path('create_field', {slug: calendar.slug}) }}">{{ ux_icon('bi:plus') }} {{ "create-field-title"|trans }}</a>
        </div>

        {# Writes the code for embed.js; phpc.js keeps the snippet and preview up to date #}
        <div class="tab-pane" id="embed" role="tabpanel" aria-labelledby="embed-tab">
            <p class="text-secondary">{{ "embed-help"|trans }}</p>
            <div class="row g-4 phpc-embed-builder" data-script="{{ absolute_url(asset('static/embed.js')) }}"
                 data-calendar="{{ url('default_view', {slug: calendar.slug}) }}" data-mini="{{ url('mini_view', {slug: calendar.slug}) }}">
                <div class="col-lg-4">
                    <div class="mb-3">
                        <label class="form-label" for="embed-widget">{{ "embed-show-label"|trans }}</label>
                        <select class="form-select" id="embed-widget" name="widget" aria-describedby="embed-widget-help">
                            <option value="full">{{ "embed-full-option"|trans }}</option>
                            <option value="mini">{{ "embed-mini-option"|trans }}</option>
                        </select>
                        <div class="form-text" id="embed-widget-help">{{ "embed-widget-help"|trans }}</div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="embed-header" name="header" checked>
                        <label class="form-check-label" for="embed-header">{{ "embed-header-label"|trans }}</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="embed-bg">{{ "embed-background-label"|trans }}</label>
                        <div class="input-group">
                            <select class="form-select" id="embed-bg" name="bg">
                                <option value="">{{ "embed-from-theme-option"|trans }}</option>
                                <option value="transparent">{{ "embed-transparent-option"|trans }}</option>
                                <option value="color">{{ "embed-color-option"|trans }}</option>
                            </select>
                            <input type="color" class="form-control form-control-color" name="bg_color" value="#ffffff"
                                   aria-label="{{ "embed-background-label"|trans }}">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="embed-accent">{{ "embed-accent-label"|trans }}</label>
                        <div class="input-group">
                            <select class="form-select" id="embed-accent" name="accent">
                                <option value="">{{ "embed-from-theme-option"|trans }}</option>
                                <option value="color">{{ "embed-color-option"|trans }}</option>
                            </select>
                            <input type="color" class="form-control form-control-color" name="accent_color" value="#0d6efd"
                                   aria-label="{{ "embed-accent-label"|trans }}">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="embed-font">{{ "embed-font-label"|trans }}</label>
                        <input type="text" class="form-control" id="embed-font" name="font" maxlength="200"
                               placeholder="Georgia, serif" aria-describedby="embed-font-help">
                        <div class="form-text" id="embed-font-help">{{ "embed-font-help"|trans }}</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="embed-mode">{{ "color-mode-menu-label"|trans }}</label>
                        <select class="form-select" id="embed-mode" name="mode">
                            <option value="light">{{ "color-mode-light"|trans }}</option>
                            <option value="dark">{{ "color-mode-dark"|trans }}</option>
                            <option value="auto">{{ "color-mode-auto"|trans }}</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="embed-theme">{{ "theme-label"|trans }}</label>
                        <select class="form-select" id="embed-theme" name="theme">
                            <option value="">{{ "embed-calendar-theme-option"|trans }}</option>
                            {% for theme in themes() %}
                                <option value="{{ theme.id }}">{{ theme.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="embed-min-height">{{ "embed-min-height-label"|trans }}</label>
                        <input type="number" class="form-control" id="embed-min-height" name="min_height" value="400" min="100" step="50">
                    </div>
                </div>
                <div class="col-lg-8">
                    <label class="form-label" for="embed-snippet">{{ "embed-code-label"|trans }}</label>
                    <div class="input-group mb-3">
                        <textarea class="form-control font-monospace small phpc-embed-snippet" id="embed-snippet" rows="4" readonly></textarea>
                        <button class="btn btn-outline-secondary" type="button" data-phpc-copy="embed-snippet"
                                data-copied-label="{{ 'link-copied-message'|trans }}">{{ ux_icon('bi:clipboard') }} {{ 'copy-link-button'|trans }}</button>
                    </div>
                    <p class="form-label">{{ "embed-preview-label"|trans }}</p>
                    <div class="border rounded p-2 bg-body-secondary">
                        <iframe class="w-100 border-0 d-block phpc-embed-preview" title="{{ "embed-preview-label"|trans }}"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
