{% extends "base.html.twig" %}

{% block title %}{{ 'update-database-title'|trans }}{% endblock %}

{% block body %}
    <div class="phpc-narrow">
        <h1 class="h3">{{ 'update-database-title'|trans }}</h1>
        <p>{{ 'update-database-help'|trans }}</p>
        <form method="post" action="{{ path('setup_update') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('setup-update') }}">
            <button type="submit" class="btn btn-primary">{{ 'update-database-button'|trans }}</button>
        </form>
    </div>
{% endblock %}
